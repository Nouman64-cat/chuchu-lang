function fahrenheit(text: string) be result<float> {
    assign parsed as parse_float(text)
    if is_ok(parsed) {
        assign celsius as unwrap(parsed)
        if celsius < -273.15 {
            return err<float>(8)
        }
        return ok(celsius * 1.8 + 32)
    }
    return parsed
}

show "Celsius to Fahrenheit. Enter a number or quit."
assign running as true
while running {
    show "Celsius:"
    assign line as try_input()
    if is_eof(line) {
        reassign running as false
    } else {
        if is_ok(line) {
            assign text as unwrap(line)
            if text == "quit" {
                reassign running as false
            } else {
                assign converted as fahrenheit(text)
                if is_ok(converted) {
                    show to_string(unwrap(converted)) + " F"
                } else {
                    if error_code(converted) == 8 {
                        show "Try again: temperature is below absolute zero"
                    } else {
                        show "Try again: " + error_message(converted)
                    }
                }
            }
        } else {
            show "Input error: " + error_message(line)
            reassign running as false
        }
    }
}
show "Done."
