function greet(name: string) be string {
    return "Hello, " + name + "!"
}

assign name as "دنیا 🌍"
assign message as greet(name)
show message
show len(name)
show message == "Hello, دنیا 🌍!"
reassign message as message + " Welcome to Chuchu."
show message
show "Escapes: \"quotes\", \\backslash, and\ttab"
