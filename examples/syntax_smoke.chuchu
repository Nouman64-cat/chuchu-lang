function square(x: int) -> int {
    return x * x
}

function half(x: float) -> float {
    return x / 2.0
}

function is_positive(x: int) -> bool {
    return x > 0
}

assign number 5
show square(number)

reassign number 10
show square(number)

show half(9.0)
show is_positive(number)

assign counter 0

while counter < 3 {
    show counter
    reassign counter counter + 1
}
