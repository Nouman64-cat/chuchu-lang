function square(x: int) be int {
    return x * x
}

function half(x: float) be float {
    return x / 2.0
}

function is_positive(x: int) be bool {
    return x > 0
}

assign number as 5
show square(number)

reassign number as 10
show square(number)

show half(9.0)
show is_positive(number)

assign counter as 0

while counter < 3 {
    show counter
    reassign counter as counter + 1
}
